# Set only the providers you want to probe. A bare `wirecheck` run uses whatever
# is configured here and skips the rest — no key is ever required to run the
# offline test suite.
#
# Nothing in this repo reads or writes a real .env; these are environment
# variables. Keep your actual keys out of the working tree.

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=

# Cloudflare Workers AI needs both.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Ollama needs no key. Override the host if it is not local.
# OLLAMA_HOST=http://localhost:11434

# Optional overrides.
# WIRECHECK_TIMEOUT_MS=120000        # raise for slow local models
# WIRECHECK_OPENAI_MODEL=gpt-4o-mini
# WIRECHECK_OLLAMA_MODEL=qwen3:8b
